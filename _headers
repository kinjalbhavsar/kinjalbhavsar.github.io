# Cloudflare Pages applies these response headers (same mechanism as _redirects).
# Note: only active on the Cloudflare deploy — not locally, not on the github.io mirror.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Long-lived caching for static, rarely-changing assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400
